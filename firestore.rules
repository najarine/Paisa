rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Single-user personal financial records: only the authenticated owner can read or write
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{allSubcollections=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Disabled for single-user app security
    match /partner_invitations/{invitationId} {
      allow read, write: if false;
    }

    match /invitations/{invitationId} {
      allow read, write: if false;
    }

    match /shared_finances/{partnershipId} {
      allow read, write: if false;
      match /{allSubcollections=**} {
        allow read, write: if false;
      }
    }

    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}
